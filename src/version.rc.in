#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PLUGIN_VERSION_TWEAK@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PLUGIN_VERSION_TWEAK@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "SKSE plugin for Wheeler / Skyrim Souls / For Honor slow-time compatibility\0"
            VALUE "CompanyName", "@PLUGIN_AUTHOR@\0"
            VALUE "FileDescription", "@PLUGIN_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "@PROJECT_VERSION@.@PLUGIN_VERSION_TWEAK@\0"
            VALUE "InternalName", "@PROJECT_NAME@\0"
            VALUE "LegalCopyright", "@PLUGIN_COPYRIGHT@\0"
            VALUE "OriginalFilename", "@PROJECT_NAME@.dll\0"
            VALUE "ProductName", "@PLUGIN_PRODUCT_NAME@\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@.@PLUGIN_VERSION_TWEAK@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
